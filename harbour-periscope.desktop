[Desktop Entry]
Type=Application
X-Nemo-Application-Type=silica-qt5
Categories=Utility;
Icon=harbour-periscope
Exec=harbour-periscope
Name=Periscope
Comment=Upload pictures to Panoramax

[X-HarbourBackup]
BackupPathList=.config/dev.scarpino/harbour-periscope/

[X-Sailjail]
Permissions=Internet;Secrets;MediaIndexing;Pictures;Camera;Location
OrganizationName=dev.scarpino
ApplicationName=harbour-periscope
